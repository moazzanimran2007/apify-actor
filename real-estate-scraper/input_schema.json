{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Real Estate Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "startUrls": {
      "title": "Start URLs",
      "type": "array",
      "description": "Array of URLs to start crawling (Zillow/Redfin/Realtor.com search pages)",
      "editor": "urlList",
      "prefill": [
        {
          "url": "https://www.zillow.com/homes/for_sale/"
        }
      ]
    },
    "location": {
      "title": "Location",
      "type": "string",
      "description": "Location filter (e.g., 'San Francisco, CA', 'New York, NY')",
      "default": ""
    },
    "maxRequestsPerCrawl": {
      "title": "Max Requests Per Crawl",
      "type": "integer",
      "description": "Maximum number of pages to crawl",
      "default": 100,
      "minimum": 1,
      "maximum": 10000
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "description": "Proxy configuration for residential proxies",
      "default": {
        "useApifyProxy": true,
        "apifyProxyGroups": ["RESIDENTIAL"]
      }
    },
    "maxConcurrency": {
      "title": "Max Concurrency",
      "type": "integer",
      "description": "Maximum number of concurrent requests",
      "default": 5,
      "minimum": 1,
      "maximum": 20
    },
    "requestDelay": {
      "title": "Request Delay (seconds)",
      "type": "number",
      "description": "Delay between requests in seconds",
      "default": 3,
      "minimum": 1,
      "maximum": 10
    },
    "followDetailPages": {
      "title": "Follow Detail Pages",
      "type": "boolean",
      "description": "Whether to follow and scrape property detail pages",
      "default": true
    }
  },
  "required": ["startUrls"]
}

